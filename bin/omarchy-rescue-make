#!/bin/bash

# Build Omarchy Rescue into ./release.
#
#   bin/omarchy-rescue-make [--edge|--rc] [--with-installer] [other omarchy-iso-make flags]
#
# By default this builds the rescue-only ISO: Omarchy's live system with the
# rescue layer, installed from the online repos, small enough for a GitHub
# release. --with-installer builds the full Omarchy ISO with rescue added in
# front of the stock installer, through omarchy-iso's own build; the extra flags
# pass straight through to omarchy-iso-make in that mode.
#
# Either way it starts from a fresh copy of the pinned omarchy-iso checkout and
# never mounts the host's pacman cache into the build container. Upstream
# mounts it and then has to wipe it with sudo before every build, because a
# cached file can differ from the Omarchy mirror's copy under the same name.

set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD=$ROOT/build/omarchy-iso
RELEASE=$ROOT/release

with_installer=
mirror=stable
iso_make_args=(--no-boot-offer --keep-pkg-cache)
for arg in "$@"; do
  case $arg in
  --with-installer) with_installer=1 ;;
  --keep-pkg-cache | --no-boot-offer) ;;
  *)
    case $arg in
    --edge | --dev | --quattro) mirror=edge ;;
    --rc) mirror=rc ;;
    esac
    iso_make_args+=("$arg")
    ;;
  esac
done

git -C "$ROOT" submodule update --init --recursive

rm -rf "$BUILD"
mkdir -p "${BUILD%/*}" "$RELEASE"
git clone --quiet "$ROOT/omarchy-iso" "$BUILD"
git -C "$BUILD" -c protocol.file.allow=always submodule update --init --quiet \
  --reference "$ROOT/omarchy-iso/archiso"

# The docker group is root-equivalent, so fall back to sudo the way
# omarchy-iso-make does when the socket refuses the calling user.
DOCKER=(docker)
docker version &>/dev/null || DOCKER=(sudo docker)

if [[ -n $with_installer ]]; then
  "$ROOT/builder/apply-rescue.sh" "$BUILD"

  host_cache='  DOCKER_ARGS+=(-v "/var/cache/pacman/pkg:/var/cache/pacman/pkg")'
  grep -qxF "$host_cache" "$BUILD/bin/omarchy-iso-make" || {
    echo "omarchy-iso-make no longer mounts the host pacman cache the way this expects" >&2
    exit 1
  }
  HOST_CACHE=$host_cache awk '$0 == ENVIRON["HOST_CACHE"] { print "  :"; next } { print }' \
    "$BUILD/bin/omarchy-iso-make" >"$BUILD/bin/omarchy-iso-make.new"
  mv "$BUILD/bin/omarchy-iso-make.new" "$BUILD/bin/omarchy-iso-make"
  chmod +x "$BUILD/bin/omarchy-iso-make"
  bash -n "$BUILD/bin/omarchy-iso-make"

  (cd "$BUILD" && ./bin/omarchy-iso-make "${iso_make_args[@]}")
else
  "$ROOT/builder/apply-rescue.sh" --rescue-only "$BUILD"

  mkdir -p "$BUILD/release"
  "${DOCKER[@]}" run --rm --privileged \
    -e "OMARCHY_MIRROR=$mirror" \
    -e "HOST_UID=$(id -u)" \
    -e "HOST_GID=$(id -g)" \
    -v "$BUILD/release:/out" \
    -v "$BUILD/archiso:/archiso:ro" \
    -v "$BUILD/builder:/builder:ro" \
    -v "$BUILD/configs:/configs:ro" \
    -v "$ROOT/builder/build-rescue-only.sh:/build-rescue-only.sh:ro" \
    archlinux/archlinux:latest /build-rescue-only.sh
fi

iso=$(\ls -t "$BUILD"/release/*.iso | head -n1)
mv -f "$iso" "$RELEASE/"
echo
echo "Built $RELEASE/${iso##*/} ($(du -h "$RELEASE/${iso##*/}" | cut -f1))"
