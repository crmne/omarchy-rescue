#!/bin/bash

# Unlock and mount an installed Omarchy system at /mnt (or the given target),
# exactly as it mounts itself: the LUKS container, the @ subvolume as root, and
# then everything else from its own fstab (@home, @log, @pkg, the ESP at /boot).
#
#   omarchy-rescue-mount [target]
#   omarchy-rescue-mount --unmount [target]

set -euo pipefail

unmount() {
  local target=$1 mapper
  if mountpoint -q "$target"; then
    sync
    umount -R "$target"
    echo "Unmounted $target."
  fi
  for mapper in /dev/mapper/omarchy_root*; do
    [[ -e $mapper ]] || continue
    cryptsetup close "${mapper##*/}" && echo "Locked ${mapper##*/}."
  done
}

unlock_luks() {
  local device name index=0
  while read -r device; do
    # Already unlocked, by us or by hand.
    if lsblk -rno TYPE "$device" | grep -qx crypt; then
      continue
    fi
    name=omarchy_root
    ((index > 0)) && name=omarchy_root$index
    index=$((index + 1))

    echo "Unlocking $device (the passphrase you type at boot)"
    cryptsetup open "$device" "$name" </dev/tty || echo "Could not unlock $device; skipping it."
  done < <(lsblk -rpno NAME,FSTYPE | awk '$2 == "crypto_LUKS" { print $1 }')
}

# Omarchy labels its Btrfs filesystem OMARCHY. Failing that, take the first
# Btrfs filesystem that has an @ subvolume, and failing that, ask.
find_root() {
  local device probe

  device=$(blkid -t LABEL=OMARCHY -o device 2>/dev/null | head -n1 || true)
  [[ -n $device ]] && echo "$device" && return

  probe=$(mktemp -d)
  while read -r device; do
    if mount -o ro,subvolid=5 "$device" "$probe" 2>/dev/null; then
      if [[ -d $probe/@/etc ]]; then
        umount "$probe"
        rmdir "$probe"
        echo "$device"
        return
      fi
      umount "$probe"
    fi
  done < <(blkid -t TYPE=btrfs -o device 2>/dev/null)
  rmdir "$probe"

  device=$(lsblk -rpno NAME,FSTYPE,SIZE,LABEL | awk '$2 != "" && $2 != "crypto_LUKS" && $2 != "swap" && $2 != "squashfs" && $2 != "iso9660"' |
    gum choose --header "Couldn't find an Omarchy install. Which filesystem is your root?" | awk '{ print $1 }') || true
  [[ -n $device ]] && echo "$device"
}

mount_installed() {
  local target=$1 root

  if mountpoint -q "$target"; then
    echo "$target is already mounted:"
    findmnt -R "$target"
    return
  fi

  unlock_luks

  root=$(find_root)
  if [[ -z $root ]]; then
    echo "No root filesystem found." >&2
    exit 1
  fi

  mkdir -p "$target"
  if [[ $(blkid -s TYPE -o value "$root") == btrfs ]]; then
    mount -o noatime,compress=zstd,subvol=@ "$root" "$target"
  else
    mount "$root" "$target"
  fi

  # The rest comes from the installed system's own fstab, so this follows
  # whatever layout that system actually has. / is already mounted and swap is
  # skipped by mount -a.
  if [[ -f $target/etc/fstab ]]; then
    mount --all --fstab "$target/etc/fstab" --target-prefix "$target" ||
      echo "Some fstab entries did not mount; see above." >&2
  fi

  echo
  findmnt -R "$target"
  echo
  gum style --foreground 2 "Mounted at $target. Run arch-chroot $target to work inside it."
  gum style --foreground 4 "Unmount and lock again with: omarchy-rescue-mount --unmount"
}

if [[ ${1:-} == --unmount || ${1:-} == -u ]]; then
  unmount "${2:-/mnt}"
else
  mount_installed "${1:-/mnt}"
fi
