#!/bin/bash

# Omarchy Rescue: the welcome screen, and a menu over the rescue helpers for
# anyone who'd rather pick than type.

welcome() {
  local logo=/usr/share/omarchy/logo.txt
  [[ -f $logo ]] && gum style --foreground 2 "$(<"$logo")" && echo

  gum style --foreground 4 --bold "Omarchy Rescue"
  cat <<'TEXT'
A live Omarchy console with rescue tools and AI agents. Nothing here touches
your disks until you ask it to.

  omarchy-rescue          menu of everything below
  omarchy-rescue-keyboard change the keyboard layout (it starts as US)
  impala                  connect to Wi-Fi (Ethernet just works)
  omarchy-rescue-mount    unlock and mount your Omarchy install at /mnt
  arch-chroot /mnt        run commands inside your installed system
  omarchy-rescue-share    drive this console from your phone's browser
  omarchy-rescue-login    sign in to claude, codex, or opencode
  claude  codex  opencode start an agent and describe what's broken

  C-Space u               open the last link on screen on your phone
  C-Space o               open the menu in a new window
  C-Space ?               list every key binding
TEXT
  echo
}

online() {
  curl -s -m 5 -o /dev/null https://pkgs.omarchy.org
}

require_online() {
  online && return
  gum style --foreground 3 "No internet connection yet. Connect Wi-Fi with impala, or plug in Ethernet."
  return 1
}

update_agents() {
  require_online || return
  pacman -Sy --needed --noconfirm archlinux-keyring omarchy-keyring &&
    pacman -S --noconfirm claude-code openai-codex-bin opencode
}

chroot_installed() {
  mountpoint -q /mnt || omarchy-rescue-mount || return
  arch-chroot /mnt
}

menu() {
  local choice
  while true; do
    choice=$(gum choose --header "Omarchy Rescue" \
      "Start Claude Code" \
      "Start Codex" \
      "Start OpenCode" \
      "Sign in to an agent" \
      "Change the keyboard layout" \
      "Connect to Wi-Fi" \
      "Share this console with a phone" \
      "Mount installed Omarchy at /mnt" \
      "Chroot into installed Omarchy" \
      "Update the agents" \
      "Exit to shell") || return 0

    case $choice in
    "Start Claude Code") claude ;;
    "Start Codex") codex ;;
    "Start OpenCode") opencode ;;
    "Sign in to an agent") omarchy-rescue-login ;;
    "Change the keyboard layout") omarchy-rescue-keyboard ;;
    "Connect to Wi-Fi") impala ;;
    "Share this console with a phone") omarchy-rescue-share ;;
    "Mount installed Omarchy at /mnt") omarchy-rescue-mount ;;
    "Chroot into installed Omarchy") chroot_installed ;;
    "Update the agents") update_agents ;;
    "Exit to shell") return 0 ;;
    esac

    echo
    gum input --placeholder "Press Enter to return to the menu" >/dev/null || return 0
  done
}

case ${1:-menu} in
welcome) welcome ;;
menu) menu ;;
update) update_agents ;;
*)
  echo "Usage: omarchy-rescue [welcome|menu|update]" >&2
  exit 1
  ;;
esac
