#!/usr/bin/env python3

# Hand the last link on screen to a phone, and take a sign-in code back. Bound
# to C-Space u in the rescue tmux session.
#
# Shows one QR code for a one-time page served on the local network. The page
# opens the link on the phone and has a box to paste the code the agent asks
# for; the code is typed into the pane underneath, without pressing Enter, so
# nothing runs until you confirm it at the console. The page stops after one
# paste, or when this popup is closed.
#
# Offline, it falls back to a QR code of the link itself.

import html
import os
import re
import secrets
import shutil
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs

URL = re.compile(r"https?://[^\s\"'<>│┃|]+")
PORT = 7682


def tmux(*args):
    return subprocess.run(["tmux", *args], check=True, capture_output=True, text=True).stdout


def pane_text(pane):
    width = int(tmux("display-message", "-p", "-t", pane, "#{pane_width}").strip())
    # -J rejoins lines the terminal soft-wrapped at the pane edge.
    lines = tmux("capture-pane", "-p", "-J", "-S", "-1000", "-t", pane).splitlines()

    # Some programs hard-wrap long links themselves. A line that runs to the
    # pane edge and ends mid-link continues on the next line, so glue those
    # back together before looking for links.
    text = ""
    previous = ""
    for line in lines:
        link_so_far = text.rsplit("\n", 1)[-1].rstrip().split(" ")[-1]
        glued = (
            width - 2 <= len(previous.rstrip()) <= width
            and URL.search(link_so_far)
            and line[:1] not in ("", " ")
        )
        text += line if glued else "\n" + line
        previous = line
    return text


def lan_address():
    route = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True).stdout.split()
    return route[route.index("src") + 1] if "src" in route else None


def qr(text):
    return subprocess.run(
        ["qrencode", "-t", "ansiutf8", "-m", "1", "-l", "L", text],
        check=True, capture_output=True, text=True,
    ).stdout


def fits(code):
    columns, rows = shutil.get_terminal_size()
    lines = code.splitlines()
    width = len(re.sub(r"\x1b\[[0-9;]*m", "", lines[0])) if lines else 0
    return width <= columns and len(lines) <= rows, rows - len(lines)


PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Omarchy Rescue</title>
<style>
  body {{ margin: 0; padding: 24px; background: #1a1b26; color: #c0caf5; font: 17px/1.5 system-ui, sans-serif; }}
  h1 {{ font-size: 20px; color: #7aa2f7; margin: 0 0 20px; }}
  a.button, button {{ display: block; box-sizing: border-box; width: 100%; padding: 14px; border: 0; border-radius: 10px;
    background: #7aa2f7; color: #1a1b26; font: 600 17px system-ui, sans-serif; text-align: center; text-decoration: none; }}
  textarea {{ box-sizing: border-box; width: 100%; height: 120px; margin: 8px 0 12px; padding: 12px; border-radius: 10px;
    border: 1px solid #414868; background: #16161e; color: #c0caf5; font: 15px ui-monospace, monospace; }}
  .step {{ margin: 28px 0 0; color: #a9b1d6; }}
  .link {{ margin-top: 8px; font: 12px ui-monospace, monospace; color: #565f89; word-break: break-all; }}
</style></head>
<body>
<h1>Omarchy Rescue</h1>
<p class="step">1. Open the link from the rescue console and sign in.</p>
<a class="button" href="{link}" target="_blank" rel="noopener">Open link</a>
<div class="link">{link}</div>
<form method="post">
  <p class="step">2. If it gives you a code to paste back, send it here.</p>
  <textarea name="code" placeholder="Paste the code here" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
  <button type="submit">Send to the rescue console</button>
</form>
</body></html>
"""

DONE = """<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Omarchy Rescue</title>
<style>body { margin: 0; padding: 24px; background: #1a1b26; color: #c0caf5; font: 17px/1.5 system-ui, sans-serif; }
h1 { font-size: 20px; color: #9ece6a; }</style></head>
<body><h1>Sent</h1><p>The code is waiting at the rescue console's prompt. Press Enter there to finish.</p>
<p>Some sign-in prompts don't show what's typed into them, so the code may not appear on screen.</p></body></html>
"""


def serve(link, pane, token):
    class Handoff(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def reply(self, status, body):
            data = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path != f"/{token}/":
                return self.reply(404, "Not found")
            self.reply(200, PAGE.format(link=html.escape(link, quote=True)))

        def do_POST(self):
            if self.path != f"/{token}/":
                return self.reply(404, "Not found")
            length = min(int(self.headers.get("Content-Length") or 0), 65536)
            code = parse_qs(self.rfile.read(length).decode()).get("code", [""])[0]
            # Printable characters only: no newline or escape sequence can
            # reach the shell, so the code can't run anything by itself.
            code = "".join(ch for ch in code if ch.isprintable()).strip()
            if not code:
                return self.reply(400, PAGE.format(link=html.escape(link, quote=True)))
            tmux("send-keys", "-t", pane, "-l", code)
            # Sign-in prompts often hide what's typed, so say it arrived.
            tmux("display-message", "-d", "15000", "Code received from your phone. Press Enter to use it.")
            self.reply(200, DONE)
            # One paste, then the page is gone and the popup closes.
            threading.Timer(0.5, lambda: os._exit(0)).start()

    server = HTTPServer(("0.0.0.0", PORT), Handoff)
    threading.Thread(target=server.serve_forever, daemon=True).start()


def main():
    pane = sys.argv[1] if len(sys.argv) > 1 else tmux("display-message", "-p", "#{pane_id}").strip()
    links = URL.findall(pane_text(pane))
    if not links:
        print("No link on screen yet. Run the sign-in command first, then press C-Space u again.")
        input("\nPress Enter to close.")
        return

    link = links[-1].rstrip(".,;:)]}")
    address = lan_address()

    if address:
        token = secrets.token_hex(12)
        try:
            serve(link, pane, token)
        except OSError:
            address = None

    if address:
        code = qr(f"http://{address}:{PORT}/{token}/")
        ok, spare = fits(code)
        print(code, end="")
        if spare >= 4:
            print("\nScan with your phone to open the link there and paste the code back.")
            print("Your phone must be on the same network. Press Enter to close.", end="", flush=True)
        input()
        return

    code = qr(link)
    ok, spare = fits(code)
    if not ok:
        print("This link is too long for a QR code on this screen, and there's no")
        print("network to hand it over. Connect first (impala for Wi-Fi), then try again.\n")
        print(link)
        input("\nPress Enter to close.")
        return
    print(code, end="")
    if spare >= 2:
        print("\nScan with your phone. Press Enter to close.", end="", flush=True)
    input()


if __name__ == "__main__":
    main()
