#!/bin/bash

# Sign in to an agent from a console with no browser. Each agent prints a link
# to open on another device; as soon as it does, this pops up a QR code for a
# page on your phone that opens the link and takes the code back
# (omarchy-rescue-qr, also on C-Space u).
#
# Claude Code is started as-is: its first run signs in by itself, and a
# separate `claude auth login` beforehand doesn't spare that, so it would ask
# twice. Codex and OpenCode sign in with their own commands first.

set -euo pipefail

agent=${1:-}
if [[ -z $agent ]]; then
  agent=$(gum choose --header "Sign in to which agent?" claude codex opencode)
fi

if ! curl -s -m 5 -o /dev/null https://pkgs.omarchy.org; then
  gum style --foreground 3 "No internet connection yet. Connect Wi-Fi with impala, or plug in Ethernet."
  exit 1
fi

gum style --foreground 4 \
  "A QR code will pop up when the sign-in link appears. Scan it with your phone" \
  "to open the link there and send the code back to this console."
echo

# Watch for the agent's link, then hand it to the phone. Only a link that
# wasn't on screen before counts, so an old one can't trigger the popup. Five
# minutes covers Claude Code's first-run questions before its sign-in link.
links_on_screen() {
  tmux capture-pane -p -J -S -1000 -t "$TMUX_PANE" | { grep -o 'https\?://' || true; } | wc -l
}
if [[ -n ${TMUX_PANE:-} ]]; then
  client=$(tmux display-message -p '#{client_name}')
  before=$(links_on_screen)
  (
    for _ in $(seq 1 600); do
      sleep 0.5
      if (($(links_on_screen) > before)); then
        sleep 0.5 # let the whole link finish printing
        tmux display-popup -c "$client" -E -B -w 100% -h 100% "omarchy-rescue-qr '$TMUX_PANE'"
        break
      fi
    done
  ) &
  watcher=$!
  trap 'kill "$watcher" 2>/dev/null' EXIT
fi

case $agent in
claude)
  claude
  exit
  ;;
codex) codex login --device-auth ;;
opencode)
  # OpenCode's own account signs in with a device link that carries its code.
  # The command for it changed name between major versions. `opencode auth
  # login` alone is for other providers' API keys.
  if [[ $(opencode --version 2>/dev/null) == 1.* ]]; then
    opencode console login
  else
    opencode auth login opencode
  fi
  ;;
*)
  echo "Unknown agent: $agent (expected claude, codex, or opencode)" >&2
  exit 1
  ;;
esac

echo
if gum confirm "Start $agent now?"; then
  exec "$agent"
fi
